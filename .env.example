# DARK Environment Example (copy to .env — never commit real secrets)
DARK_ENV=development
DARK_PG_USER=dark
DARK_PG_PASSWORD=replace-with-strong-local-db-password
DARK_PG_DB=dark
DARK_REDIS_PASSWORD=replace-with-strong-redis-password
DARK_VAULT_KEY=replace-with-64-char-random-vault-master-secret
DARK_CORS_ORIGINS=https://dark.example.com
